# Plant Leaf Disease Detector - Environment Configuration

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=false

# AI Service API Keys
GROK_API_KEY=your_grok_api_key_here
PLANTNET_API_KEY=your_plantnet_api_key_here

# Database Paths
DISEASES_DB_PATH=database/diseases.json
TREATMENTS_DB_PATH=database/treatments.json
REFERENCE_IMAGES_PATH=database/reference_images

# Image Processing
MAX_FILE_SIZE_MB=10
SUPPORTED_FORMATS=jpg,jpeg,png,webp
MIN_IMAGE_SIZE=512
MAX_IMAGE_SIZE=1024

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
RATE_LIMITING_ENABLED=true

# Frontend Configuration
BACKEND_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30

# UI Configuration
MAX_FILE_SIZE_MB=10
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp
MIN_IMAGE_WIDTH=512
MIN_IMAGE_HEIGHT=512

# Feature Flags
ENABLE_ADVANCED_ANALYSIS=true
ENABLE_TREATMENT_CALCULATOR=true
ENABLE_RESULT_SHARING=true

# Performance
IMAGE_CACHE_SIZE=100
REQUEST_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis Configuration (for production)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Services
WEATHER_API_KEY=your_weather_api_key_here  # Optional for disease prediction
LOCATION_API_KEY=your_location_api_key_here  # Optional for regional disease data